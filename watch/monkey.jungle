project.manifest = manifest.xml

# Per-device launcher icons.
#
# The artwork lives in exactly one place - resources/drawables/launcher_icon.svg,
# whose intrinsic size is 40x40. Devices whose launcher is a different size
# pick up a resources-icon<size>/ override that points at that same SVG and sets
# scaleX/scaleY, so the icon is rasterised at the device's launcher size instead
# of being scaled by the compiler (which warns on every build).
#
# The launcher size is not something to guess: it is launcherIcon.width in
# %APPDATA%\Garmin\ConnectIQ\Devices\<id>\compiler.json. This block is GENERATED -
# after adding or removing an <iq:product>, run tools\Sync-IconTargets.ps1 rather
# than editing it by hand, or the export build starts warning again.

# 54x54
fr165m.resourcePath = $(fr165m.resourcePath);resources-icon54
fr170m.resourcePath = $(fr170m.resourcePath);resources-icon54
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-icon54
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-icon54
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-icon54

# 56x56
approachs50.resourcePath = $(approachs50.resourcePath);resources-icon56
vivoactive5.resourcePath = $(vivoactive5.resourcePath);resources-icon56

# 60x60
