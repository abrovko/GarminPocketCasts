<!--
    Properties backing the app settings the user edits in Garmin Connect
    Mobile. See resources/settings/settings.xml for how they are presented,
    and Proxy.mc for what is done with them.

    THESE ARE AN INPUT CHANNEL, NOT THE STORE. Proxy.applyPhoneSettings()
    copies a changed value into Storage, which is what the rest of the app
    reads. They exist because WatchUi.TextPicker caps entry at 31 characters
    on this hardware and a proxy address does not fit in that.
-->
<properties>
    <property id="proxyServerProp" type="string"></property>
    <property id="proxyTokenProp" type="string"></property>
</properties>
